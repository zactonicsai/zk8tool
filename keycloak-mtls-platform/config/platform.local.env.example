# Copy to config/platform.local.env (git-ignored) and keep only what differs
# from config/platform.env. Values here win over platform.env.

IMAGE_TAG=1.0.0-rc1

# Azure
ACR_NAME=myregistry
AKS_RESOURCE_GROUP=rg-platform
AKS_CLUSTER=aks-platform

# Public hostnames (also added to the certificate SANs)
KC_PUBLIC_URL=https://sso.example.com
APP_PUBLIC_URL=https://app.example.com
CERT_EXTRA_SANS_KEYCLOAK=sso.example.com
CERT_EXTRA_SANS_APP=app.example.com

# Production database (credentials come from a Kubernetes Secret, see docs/helm/values.md)
KC_DB_VENDOR=postgres
HELM_VALUES=helm/iam-platform/values-production.yaml
