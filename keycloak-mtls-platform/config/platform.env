# =============================================================================
# platform.env - single source of configuration for scripts/platform.sh
#
# Format : KEY=VALUE, one per line. '#' starts a comment. Values may be quoted.
#          ${OTHER_KEY} references are expanded; nothing else is evaluated
#          (the file is PARSED, never sourced, so it cannot run code).
# Order  : CLI flag  >  environment variable  >  config/platform.local.env
#          >  this file  >  built-in default
# Secrets: never put passwords, tokens or private keys in this file.
# Docs   : docs/02-configuration.md
# =============================================================================

# --- Project -----------------------------------------------------------------
PROJECT_NAME=iam-platform
# Tag applied to all three images. Use an immutable value (git SHA / semver).
IMAGE_TAG=0.1.0
# Scratch space for certs, staged build contexts and manifests (git-ignored).
BUILD_DIR=build

# --- Versions and base images ------------------------------------------------
KEYCLOAK_VERSION=26.8.2
KEYCLOAK_BASE_IMAGE=quay.io/keycloak/keycloak
JAVA_VERSION=25
JAVA_BUILD_IMAGE=eclipse-temurin:25-jdk
JAVA_RUNTIME_IMAGE=eclipse-temurin:25-jre

# --- Images ------------------------------------------------------------------
# Repository names (without registry). The registry is added at push/deploy.
IMAGE_KEYCLOAK=${PROJECT_NAME}/keycloak
IMAGE_APP=${PROJECT_NAME}/spring-app
IMAGE_CLIENT=${PROJECT_NAME}/test-client
# Target platform passed to `docker build --platform`.
IMAGE_PLATFORM=linux/amd64
# docker | podman | nerdctl
CONTAINER_CLI=docker

# --- Certificates (scripts/lib/certs.sh) -------------------------------------
CERT_DIR=${BUILD_DIR}/certs
# What is loaded INTO the images at build time:
#   trust : CA certificate only (public data). Recommended.
#   baked : CA + leaf certificate AND private key. Local demos only.
#   none  : nothing; everything is mounted at runtime.
CERT_MODE=trust
CERT_ORG="Example Corp"
CERT_OU=Platform
CERT_COUNTRY=US
# ec (P-256, default) | rsa
CERT_KEY_ALG=ec
CERT_EC_CURVE=prime256v1
CERT_RSA_BITS=3072
CERT_CA_DAYS=1825
CERT_LEAF_DAYS=90
# The SAML SP signing certificate is long-lived: rotating it needs IdP coordination.
CERT_SAML_DAYS=730
# Leaves expiring within this many days are re-issued by `platform.sh certs`.
CERT_RENEW_BEFORE_DAYS=30
# Extra subjectAltNames, comma separated (DNS names or IPs), e.g. the public
# hostnames used by an ingress / load balancer.
CERT_EXTRA_SANS_KEYCLOAK=
CERT_EXTRA_SANS_APP=

# --- Keycloak ----------------------------------------------------------------
KC_REALM=platform
# dev-file (embedded H2, single replica, evaluation only) | postgres | mariadb | mssql | mysql | oracle
# This is a Keycloak BUILD option: the image is optimised for one vendor.
KC_DB_VENDOR=dev-file
# request  : browsers may connect without a certificate; clients that present
#            one are authenticated with it (X.509 client authenticator). Default.
# required : every connection needs a client certificate (no browser logins
#            unless users hold certificates). Also a Keycloak BUILD option.
KC_HTTPS_CLIENT_AUTH=request
# Public (browser facing) base URL of Keycloak. Empty = the in-cluster service URL.
KC_PUBLIC_URL=
# Public (browser facing) base URL of the Spring app. Empty = in-cluster service URL.
APP_PUBLIC_URL=

# --- Kubernetes / Helm -------------------------------------------------------
K8S_NAMESPACE=iam
CLUSTER_DOMAIN=cluster.local
HELM_RELEASE=iam
HELM_CHART=helm/iam-platform
# Extra values files, comma separated (later files win).
HELM_VALUES=
HELM_TIMEOUT=10m
# Where pods get their TLS material:
#   secret       : Secrets created by `platform.sh secrets` from CERT_DIR
#   cert-manager : cert-manager issues and rotates them (recommended for prod)
#   image        : baked into the images (requires CERT_MODE=baked; demos only)
CERT_SOURCE=secret

# --- Azure -------------------------------------------------------------------
# Leave empty to use the current `az account`.
AZ_SUBSCRIPTION=
# Registry name only (no .azurecr.io). Required for `push`.
ACR_NAME=
# Override only for sovereign clouds (e.g. myreg.azurecr.us).
ACR_LOGIN_SERVER=
# Used by `aks-credentials` / `aks-attach`.
AKS_RESOURCE_GROUP=
AKS_CLUSTER=
