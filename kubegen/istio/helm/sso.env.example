# Settings for install.sh. Copy to sso.env and fill in:
#   cp sso.env.example sso.env
#
# sso.env holds a secret: do not commit it or share it.

# --- Required ---------------------------------------------------------------

# Host name people will open in the browser. DNS must point it at the gateway.
SSO_HOST=app.example.com

# From the application you registered with your identity provider
# (see ../README.md, Step 1). Issuer URL examples:
#   Entra ID:  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta:      https://<your-org>.okta.com
#   Google:    https://accounts.google.com
#   Keycloak:  https://keycloak.example.com/realms/<realm>
OIDC_ISSUER_URL=https://idp.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Using a Keycloak that runs in this cluster (see ../../keycloak)? Then
# replace OIDC_ISSUER_URL with its public host name. Simpler still: run
# ../../keycloak/install.sh, which installs both and fills all of this in.
#KEYCLOAK_HOST=keycloak.example.com
#KEYCLOAK_REALM=sso

# --- Optional (shown with their defaults) -----------------------------------

# HTTPS needs a kubernetes.io/tls secret with this name in namespace istio-ingress.
#TLS_ENABLED=true
#TLS_SECRET_NAME=sso-gateway-tls

# Comma-separated e-mail domains allowed to sign in. * = everyone the
# identity provider lets in.
#EMAIL_DOMAINS=*

# LoadBalancer for cloud clusters, NodePort for local ones such as kind.
#GATEWAY_SERVICE_TYPE=LoadBalancer

# Istio chart version, e.g. 1.31.0. Empty = latest.
#ISTIO_VERSION=

# Extra hosts the gateway serves without sign-in (comma-separated).
#PUBLIC_HOSTS=

# Install the httpbin test app.
#DEMO_APP=true

# --- Local test on kind over plain HTTP -------------------------------------
# Register http://localhost:8080/oauth2/callback as the redirect URI, then:
#SSO_HOST=localhost
#TLS_ENABLED=false
#EXTERNAL_PORT=8080
#GATEWAY_SERVICE_TYPE=NodePort
#GATEWAY_NODE_PORT_HTTP=30080
