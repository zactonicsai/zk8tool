# Generated by kubegen from examples/gks.yaml for the gks cluster "prod-gke".
#
# Input variables. The defaults come from the cluster definition; override
# them in terraform.tfvars (see terraform.tfvars.example) rather than here,
# because this file is overwritten when kubegen runs again.

variable "name" {
  description = "Cluster name."
  type        = string
  default     = "prod-gke"
}

variable "project" {
  description = "Google Cloud project ID."
  type        = string
  default     = "my-gcp-project"
}

variable "location" {
  description = "A region (us-central1) for a regional cluster, or a zone (us-central1-a) for a zonal one."
  type        = string
  default     = "us-central1"
}

variable "kubernetes_version" {
  description = "Minimum Kubernetes version, e.g. \"1.33\". null = the release channel's default."
  type        = string
  default     = "1.33"
}

variable "release_channel" {
  description = "Automatic upgrade channel: rapid, regular, stable or none. null = GKE default."
  type        = string
  default     = "regular"
}

variable "labels" {
  description = "Labels applied to the cluster (lowercase letters, digits, '-' and '_')."
  type        = map(string)
  default     = {
    env  = "prod"
    team = "platform"
  }
}

variable "network" {
  description = "VPC network name. null = the project's default network."
  type        = string
  default     = null
}

variable "subnetwork" {
  description = "Subnetwork name. null = chosen by GKE."
  type        = string
  default     = null
}

variable "pod_cidr" {
  description = "Pod IP range. null = chosen by GKE."
  type        = string
  default     = null
}

variable "service_cidr" {
  description = "Service IP range. null = chosen by GKE."
  type        = string
  default     = null
}

variable "private_nodes" {
  description = "Give nodes private IP addresses only (they then need Cloud NAT to reach the internet)."
  type        = bool
  default     = false
}

variable "master_cidr" {
  description = "A /28 range for the control plane of a private cluster. null = chosen by GKE."
  type        = string
  default     = null
}

variable "workload_identity" {
  description = "Enable Workload Identity so pods can use Google service accounts."
  type        = bool
  default     = true
}

variable "dataplane_v2" {
  description = "Use Dataplane V2 (Cilium-based networking with built-in network policy)."
  type        = bool
  default     = true
}

variable "deletion_protection" {
  description = "Block terraform destroy from deleting the cluster."
  type        = bool
  default     = false
}

variable "node_pools" {
  description = "Node pools, keyed by pool name. Counts are per zone in a regional cluster."
  type        = map(object({
    machine_type = string
    node_count   = optional(number, 1)
    autoscaling  = optional(object({ min = number, max = number }))
    disk_size_gb = optional(number)
    zones        = optional(list(string))
    labels       = optional(map(string), {})
    taints       = optional(list(object({ key = string, value = optional(string), effect = string })), [])
    spot         = optional(bool, false)
  }))
  default     = {
    general = {
      machine_type = "e2-standard-4"
      node_count   = 1
      disk_size_gb = 100
    }
    apps    = {
      machine_type = "e2-standard-8"
      autoscaling  = {
        min = 1
        max = 4
      }
      labels       = {
        workload = "apps"
      }
    }
    batch   = {
      machine_type = "e2-standard-8"
      autoscaling  = {
        min = 0
        max = 10
      }
      zones        = ["us-central1-a", "us-central1-b"]
      taints       = [
        {
          key    = "workload"
          value  = "batch"
          effect = "NoSchedule"
        },
      ]
      spot         = true
    }
  }
}

variable "kubeconfig_path" {
  description = "Kubeconfig file used in the get_credentials_command output. null = default."
  type        = string
  default     = null
}
