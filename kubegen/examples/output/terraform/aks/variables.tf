# Generated by kubegen from examples/aks.yaml for the aks cluster "prod-aks".
#
# Input variables. The defaults come from the cluster definition; override
# them in terraform.tfvars (see terraform.tfvars.example) rather than here,
# because this file is overwritten when kubegen runs again.

variable "name" {
  description = "Cluster name."
  type        = string
  default     = "prod-aks"
}

variable "location" {
  description = "Azure region."
  type        = string
  default     = "eastus"
}

variable "subscription_id" {
  description = "Azure subscription ID. null = taken from ARM_SUBSCRIPTION_ID."
  type        = string
  default     = null
}

variable "resource_group_name" {
  description = "Resource group for the cluster."
  type        = string
  default     = "rg-prod-aks"
}

variable "create_resource_group" {
  description = "Create the resource group (true) or use an existing one (false)."
  type        = bool
  default     = true
}

variable "kubernetes_version" {
  description = "Kubernetes version, e.g. \"1.33\". null = AKS default."
  type        = string
  default     = "1.33"
}

variable "sku_tier" {
  description = "Control plane tier: Free, Standard (uptime SLA) or Premium (long-term support)."
  type        = string
  default     = "Standard"
}

variable "tags" {
  description = "Tags applied to the resource group and cluster."
  type        = map(string)
  default     = {
    env   = "prod"
    owner = "platform team"
  }
}

variable "system_node_pool" {
  description = "System node pool (runs cluster components). Needs at least one node."
  type        = object({
    name            = string
    vm_size         = string
    node_count      = optional(number, 1)
    autoscaling     = optional(object({ min = number, max = number }))
    os_disk_size_gb = optional(number)
    zones           = optional(list(string))
    labels          = optional(map(string), {})
  })
  default     = {
    name       = "system"
    vm_size    = "Standard_D4s_v5"
    node_count = 3
    zones      = ["1", "2", "3"]
  }
}

variable "user_node_pools" {
  description = "User node pools, keyed by pool name (1-12 lowercase letters/digits)."
  type        = map(object({
    vm_size         = string
    node_count      = optional(number, 1)
    autoscaling     = optional(object({ min = number, max = number }))
    os_disk_size_gb = optional(number)
    zones           = optional(list(string))
    labels          = optional(map(string), {})
    taints          = optional(list(string), [])
    spot            = optional(bool, false)
  }))
  default     = {
    apps  = {
      vm_size         = "Standard_D8s_v5"
      autoscaling     = {
        min = 2
        max = 10
      }
      os_disk_size_gb = 128
      labels          = {
        workload = "apps"
      }
    }
    batch = {
      vm_size     = "Standard_D8s_v5"
      autoscaling = {
        min = 0
        max = 20
      }
      taints      = ["workload=batch:NoSchedule"]
      spot        = true
    }
  }
}

variable "network_plugin" {
  description = "Network plugin: azure, kubenet or none (bring your own CNI)."
  type        = string
  default     = "azure"
}

variable "network_plugin_mode" {
  description = "\"overlay\" gives pods addresses from pod_cidr instead of the VNet. null = VNet addresses."
  type        = string
  default     = "overlay"
}

variable "network_policy" {
  description = "Network policy engine: azure, calico or cilium. null = none."
  type        = string
  default     = "cilium"
}

variable "pod_cidr" {
  description = "Pod CIDR (overlay or kubenet). null = AKS default."
  type        = string
  default     = "10.244.0.0/16"
}

variable "service_cidr" {
  description = "Service CIDR. null = AKS default."
  type        = string
  default     = null
}

variable "dns_service_ip" {
  description = "Cluster DNS service IP, inside service_cidr. null = AKS default."
  type        = string
  default     = null
}

variable "vnet_subnet_id" {
  description = "Resource ID of an existing subnet for the nodes. null = AKS-managed VNet."
  type        = string
  default     = null
}

variable "private_cluster_enabled" {
  description = "Expose the API server only inside the virtual network."
  type        = bool
  default     = false
}

variable "oidc_issuer_enabled" {
  description = "Enable the OIDC issuer URL."
  type        = bool
  default     = false
}

variable "workload_identity_enabled" {
  description = "Enable Microsoft Entra Workload ID (also enables the OIDC issuer)."
  type        = bool
  default     = true
}

variable "acr_id" {
  description = "Resource ID of a container registry the nodes may pull from. null = none."
  type        = string
  default     = null
}

variable "admin_username" {
  description = "Linux admin user on the nodes (used with ssh_public_key_path)."
  type        = string
  default     = "azureuser"
}

variable "ssh_public_key_path" {
  description = "SSH public key file for node access. null = no SSH access configured."
  type        = string
  default     = null
}

variable "kubeconfig_path" {
  description = "File to write the admin kubeconfig to. null = do not write a file."
  type        = string
  default     = "~/.kube/prod-aks.yaml"
}
