# Generated by kubegen from examples/eks.yaml for the eks cluster "prod-eks".
#
# Input variables. The defaults come from the cluster definition; override
# them in terraform.tfvars (see terraform.tfvars.example) rather than here,
# because this file is overwritten when kubegen runs again.

variable "name" {
  description = "Cluster name; also prefixes the VPC and IAM role names."
  type        = string
  default     = "prod-eks"
}

variable "region" {
  description = "AWS region."
  type        = string
  default     = "us-east-1"
}

variable "aws_profile" {
  description = "AWS CLI profile to use. null = default credential chain."
  type        = string
  default     = "prod"
}

variable "kubernetes_version" {
  description = "Kubernetes version, e.g. \"1.33\". null = current EKS default."
  type        = string
  default     = "1.33"
}

variable "tags" {
  description = "Tags applied to every AWS resource."
  type        = map(string)
  default     = {
    env = "prod"
  }
}

variable "availability_zones" {
  description = "Zones to create subnets in (at least two). [] = the region's first three."
  type        = list(string)
  default     = ["us-east-1a", "us-east-1b", "us-east-1c"]
}

variable "vpc_cidr" {
  description = "CIDR of the new VPC; split into 16 equal subnet blocks."
  type        = string
  default     = "10.20.0.0/16"
}

variable "nat_gateway" {
  description = "NAT for the private subnets: Single, HighlyAvailable (one per zone) or Disable."
  type        = string
  default     = "Single"
}

variable "endpoint_public_access" {
  description = "Make the API server reachable from the internet."
  type        = bool
  default     = true
}

variable "endpoint_private_access" {
  description = "Make the API server reachable from inside the VPC."
  type        = bool
  default     = false
}

variable "private_networking" {
  description = "Place nodes in the private subnets (no public IPs; needs a NAT gateway)."
  type        = bool
  default     = true
}

variable "enable_oidc" {
  description = "Create the IAM OIDC provider, needed for IAM Roles for Service Accounts."
  type        = bool
  default     = true
}

variable "addons" {
  description = "EKS managed add-ons to install, e.g. vpc-cni, coredns, kube-proxy, aws-ebs-csi-driver."
  type        = list(string)
  default     = ["vpc-cni", "coredns", "kube-proxy", "aws-ebs-csi-driver"]
}

variable "ami_type" {
  description = "Node AMI type, e.g. AL2023_x86_64_STANDARD or BOTTLEROCKET_x86_64. null = EKS default."
  type        = string
  default     = null
}

variable "node_pools" {
  description = "Managed node groups, keyed by group name."
  type        = map(object({
    instance_type = string
    desired_size  = number
    min_size      = number
    max_size      = number
    disk_size_gb  = optional(number)
    zones         = optional(list(string), [])
    labels        = optional(map(string), {})
    taints        = optional(list(object({ key = string, value = optional(string), effect = string })), [])
    spot          = optional(bool, false)
  }))
  default     = {
    general = {
      instance_type = "m6i.large"
      desired_size  = 2
      min_size      = 2
      max_size      = 6
      disk_size_gb  = 80
      labels        = {
        workload = "general"
      }
    }
    spot    = {
      instance_type = "m6i.xlarge"
      desired_size  = 2
      min_size      = 2
      max_size      = 2
      taints        = [
        {
          key    = "spot"
          value  = "true"
          effect = "NoSchedule"
        },
      ]
      spot          = true
    }
  }
}

variable "kubeconfig_path" {
  description = "Kubeconfig file used in the update_kubeconfig_command output. null = default."
  type        = string
  default     = null
}
