# Generated by kubegen from examples/vks.yaml for the vks cluster "team-a".
#
output "cluster_name" {
  description = "Name of the VKS cluster."
  value       = var.name
}

output "kubeconfig_path" {
  description = "File the workload cluster kubeconfig was written to."
  value       = pathexpand(var.kubeconfig_path)
}

output "cluster_manifest" {
  description = "The Cluster object that was applied to the Supervisor."
  value       = yamlencode(local.cluster)
}
