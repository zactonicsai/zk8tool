# Generated by kubegen from examples/vks.yaml for the vks cluster "team-a".
#
# Input variables. The defaults come from the cluster definition; override
# them in terraform.tfvars (see terraform.tfvars.example) rather than here,
# because this file is overwritten when kubegen runs again.

variable "name" {
  description = "Cluster name."
  type        = string
  default     = "team-a"
}

variable "namespace" {
  description = "vSphere Namespace the cluster is created in."
  type        = string
  default     = "team-a-ns"
}

variable "supervisor_kubeconfig_path" {
  description = "Kubeconfig holding your Supervisor login."
  type        = string
  default     = "~/.kube/config"
}

variable "supervisor_context" {
  description = "Context for the vSphere Namespace in that kubeconfig. null = current context."
  type        = string
  default     = "team-a-ns"
}

variable "kubernetes_version" {
  description = "Kubernetes release to run."
  type        = string
  default     = "v1.33.1+vmware.1-fips"
}

variable "cluster_class" {
  description = "ClusterClass the cluster is built from."
  type        = string
  default     = "builtin-generic-v3.4.0"
}

variable "cluster_class_namespace" {
  description = "Namespace of the ClusterClass when it is not in `namespace`. null = same namespace."
  type        = string
  default     = "vmware-system-vks-public"
}

variable "cluster_api_version" {
  description = "Cluster API version served by the Supervisor."
  type        = string
  default     = "cluster.x-k8s.io/v1beta1"
}

variable "ready_condition" {
  description = "Cluster condition to wait for: Ready on v1beta1, Available on v1beta2."
  type        = string
  default     = "Ready"
}

variable "control_plane_replicas" {
  description = "Control-plane nodes: 1, 3 or 5."
  type        = number
  default     = 3
}

variable "vm_class" {
  description = "VM class for the control plane and for pools without their own."
  type        = string
  default     = "best-effort-medium"
}

variable "storage_class" {
  description = "Storage class (storage policy) for node disks."
  type        = string
  default     = "vsan-default-storage-policy"
}

variable "pod_cidr" {
  description = "Pod network CIDR. null = ClusterClass default."
  type        = string
  default     = "192.168.156.0/20"
}

variable "service_cidr" {
  description = "Service network CIDR. null = ClusterClass default."
  type        = string
  default     = "10.96.0.0/12"
}

variable "service_domain" {
  description = "Cluster DNS domain. null = cluster.local."
  type        = string
  default     = null
}

variable "labels" {
  description = "Labels set on the Cluster object."
  type        = map(string)
  default     = {
    team = "a"
  }
}

variable "node_pools" {
  description = "Worker node pools, keyed by pool name."
  type        = map(object({
    node_count  = optional(number, 1)
    vm_class    = optional(string)
    autoscaling = optional(object({ min = number, max = number }))
  }))
  default     = {
    workers = {
      node_count = 3
    }
    large   = {
      autoscaling = {
        min = 1
        max = 5
      }
      vm_class    = "guaranteed-xlarge"
    }
  }
}

variable "wait_timeout" {
  description = "How long to wait for the cluster to become ready, e.g. 30m."
  type        = string
  default     = "45m"
}

variable "kubeconfig_path" {
  description = "File the workload cluster kubeconfig is written to."
  type        = string
  default     = "./team-a.kubeconfig"
}
