# Generated by kubegen from examples/dks.yaml for the dks cluster "staging-do".
#
# Input variables. The defaults come from the cluster definition; override
# them in terraform.tfvars (see terraform.tfvars.example) rather than here,
# because this file is overwritten when kubegen runs again.

variable "name" {
  description = "Cluster name."
  type        = string
  default     = "staging-do"
}

variable "region" {
  description = "DigitalOcean region slug."
  type        = string
  default     = "nyc3"
}

variable "kubernetes_version" {
  description = "\"latest\", a prefix such as \"1.33.\" (newest matching patch), or a full slug such as \"1.33.1-do.0\"."
  type        = string
  default     = "latest"
}

variable "tags" {
  description = "Tags applied to the cluster and its droplets."
  type        = list(string)
  default     = ["env:staging"]
}

variable "ha" {
  description = "Highly available control plane. Cannot be switched off once enabled."
  type        = bool
  default     = true
}

variable "auto_upgrade" {
  description = "Install patch releases automatically during the maintenance window."
  type        = bool
  default     = true
}

variable "surge_upgrade" {
  description = "Add temporary nodes during upgrades to keep capacity."
  type        = bool
  default     = true
}

variable "vpc_uuid" {
  description = "UUID of the VPC to place the cluster in. null = the region's default VPC."
  type        = string
  default     = null
}

variable "maintenance_window" {
  description = "When automatic maintenance may start. null = chosen by DigitalOcean."
  type        = object({ day = string, start_time = string })
  default     = {
    day        = "saturday"
    start_time = "02:00"
  }
}

variable "default_node_pool" {
  description = "Default node pool. Changing its name or size replaces the cluster."
  type        = object({
    name        = string
    size        = string
    node_count  = optional(number, 1)
    autoscaling = optional(object({ min = number, max = number }))
    labels      = optional(map(string), {})
    taints      = optional(list(object({ key = string, value = optional(string), effect = string })), [])
  })
  default     = {
    name       = "default"
    size       = "s-4vcpu-8gb"
    node_count = 3
  }
}

variable "additional_node_pools" {
  description = "Additional node pools, keyed by pool name."
  type        = map(object({
    size        = string
    node_count  = optional(number, 1)
    autoscaling = optional(object({ min = number, max = number }))
    labels      = optional(map(string), {})
    taints      = optional(list(object({ key = string, value = optional(string), effect = string })), [])
  }))
  default     = {
    jobs = {
      size        = "c-4"
      autoscaling = {
        min = 1
        max = 5
      }
      labels      = {
        workload = "jobs"
      }
      taints      = [
        {
          key    = "workload"
          value  = "jobs"
          effect = "NoSchedule"
        },
      ]
    }
  }
}

variable "kubeconfig_path" {
  description = "File to write the kubeconfig to. null = do not write a file."
  type        = string
  default     = null
}
