# Generated by kubegen from examples/dks.yaml for the dks cluster "staging-do".
#
# DigitalOcean Kubernetes cluster.
#
# Authentication: export DIGITALOCEAN_TOKEN=<personal access token>
#
# Usage:
#   terraform init
#   terraform plan
#   terraform apply
#
# Override settings in terraform.tfvars (see terraform.tfvars.example).

provider "digitalocean" {}

# Resolves "latest" (or a prefix such as "1.33.") to a concrete version slug.
data "digitalocean_kubernetes_versions" "this" {
  version_prefix = var.kubernetes_version == "latest" ? null : var.kubernetes_version
}

locals {
  # A full slug such as "1.33.1-do.0" is used as given; "latest" or a prefix
  # picks the newest matching release.
  is_full_slug = can(regex("-do\\.", var.kubernetes_version))
  version      = local.is_full_slug ? var.kubernetes_version : data.digitalocean_kubernetes_versions.this.latest_version
}

resource "digitalocean_kubernetes_cluster" "this" {
  name     = var.name
  region   = var.region
  version  = local.version
  vpc_uuid = var.vpc_uuid # null = the region's default VPC
  tags     = var.tags

  ha            = var.ha            # highly available control plane; cannot be turned off again
  auto_upgrade  = var.auto_upgrade  # patch upgrades during the maintenance window
  surge_upgrade = var.surge_upgrade # add temporary nodes while upgrading

  dynamic "maintenance_policy" {
    for_each = var.maintenance_window == null ? [] : [var.maintenance_window]
    content {
      day        = maintenance_policy.value.day
      start_time = maintenance_policy.value.start_time
    }
  }

  # The default pool is part of the cluster resource. Changing its name or
  # size replaces the whole cluster; put workloads you resize often in
  # additional_node_pools instead.
  node_pool {
    name   = var.default_node_pool.name
    size   = var.default_node_pool.size
    labels = var.default_node_pool.labels

    # Fixed size, or autoscaled between min and max.
    auto_scale = var.default_node_pool.autoscaling != null
    node_count = var.default_node_pool.autoscaling == null ? var.default_node_pool.node_count : null
    min_nodes  = try(var.default_node_pool.autoscaling.min, null)
    max_nodes  = try(var.default_node_pool.autoscaling.max, null)

    dynamic "taint" {
      for_each = var.default_node_pool.taints
      content {
        key    = taint.value.key
        value  = taint.value.value
        effect = taint.value.effect
      }
    }
  }

  lifecycle {
    # With auto_upgrade the running version moves ahead of the configured one.
    ignore_changes = [version]
  }
}

# Additional pools: one per entry in var.additional_node_pools.
# Add, remove or resize pools by editing that map in terraform.tfvars.
resource "digitalocean_kubernetes_node_pool" "additional" {
  for_each = var.additional_node_pools

  cluster_id = digitalocean_kubernetes_cluster.this.id
  name       = each.key
  size       = each.value.size
  labels     = each.value.labels

  auto_scale = each.value.autoscaling != null
  node_count = each.value.autoscaling == null ? each.value.node_count : null
  min_nodes  = try(each.value.autoscaling.min, null)
  max_nodes  = try(each.value.autoscaling.max, null)

  dynamic "taint" {
    for_each = each.value.taints
    content {
      key    = taint.value.key
      value  = taint.value.value
      effect = taint.value.effect
    }
  }
}

# Write the kubeconfig to a file. The credentials are also stored in the
# Terraform state either way, so protect the state.
resource "local_sensitive_file" "kubeconfig" {
  count = var.kubeconfig_path == null ? 0 : 1

  content         = digitalocean_kubernetes_cluster.this.kube_config[0].raw_config
  filename        = pathexpand(var.kubeconfig_path)
  file_permission = "0600"
}
