# Settings for install.sh. Copy to keycloak.env and edit:
#   cp keycloak.env.example keycloak.env
#
# With no keycloak.env at all, install.sh sets up the local development
# variant (first block below). keycloak.env holds passwords: do not commit it.

# --- Local development on kind (these are the defaults) ---------------------
# Needs a kind cluster that maps localhost:8080 to node port 30080, e.g.
# created from podman/kind-podman.yaml.
#APP_HOST=localhost
#KEYCLOAK_HOST=keycloak.localhost
#TLS_ENABLED=false
#EXTERNAL_PORT=8080
#GATEWAY_SERVICE_TYPE=NodePort
#GATEWAY_NODE_PORT_HTTP=30080
#KEYCLOAK_ADMIN_USER=admin
#KEYCLOAK_ADMIN_PASSWORD=admin

# --- A real cluster (AKS, EKS, GKE, ...) ------------------------------------
# Uncomment and adjust. Both host names need DNS records pointing at the
# gateway, and the TLS secret must hold a certificate valid for both.
#APP_HOST=app.example.com
#KEYCLOAK_HOST=keycloak.example.com
#TLS_ENABLED=true
#TLS_SECRET_NAME=sso-gateway-tls
#EXTERNAL_PORT=
#GATEWAY_SERVICE_TYPE=LoadBalancer
#KEYCLOAK_ADMIN_USER=admin
#KEYCLOAK_ADMIN_PASSWORD=use-a-long-random-password
#DEMO_USER=false

# --- Other options ----------------------------------------------------------
#KEYCLOAK_REALM=sso
#KEYCLOAK_NAMESPACE=keycloak
# Pin an exact Keycloak version (default: the chart's tag).
#KEYCLOAK_IMAGE_TAG=26.6.4
# Pin the Istio version (default: latest).
#ISTIO_VERSION=1.31.0
# Keycloak only, when Istio with sign-in is already installed.
#INSTALL_ISTIO=false
