# Generated by kubegen from podman/kind-podman.yaml for the kind cluster "dev-podman".
#
# Local Kubernetes cluster running as Podman containers (kind).
#
# The community kind provider for Terraform talks to Docker only, so this
# configuration drives the kind command-line tool instead and tells it to
# use Podman (KIND_EXPERIMENTAL_PROVIDER=podman). You do not need to set
# that variable yourself.
#
# Requirements on this machine: podman, kind, and a POSIX shell (Linux,
# macOS, or WSL / Git Bash on Windows).
#
# Usage:
#   terraform init
#   terraform apply
#   terraform destroy      # deletes the cluster
#
# Override settings in terraform.tfvars (see terraform.tfvars.example).
# kind cannot modify a running cluster, so changing any setting below
# deletes the cluster and creates a new one on the next apply.

locals {
  # Host -> node port mappings, published on the first control-plane node.
  # ingress_ready adds 80 and 443. Rootless Podman cannot publish ports
  # below 1024, so ingress_ready needs rootful Podman.
  port_mappings = concat(
    var.ingress_ready ? [
      { container_port = 80, host_port = 80, protocol = "TCP" },
      { container_port = 443, host_port = 443, protocol = "TCP" },
    ] : [],
    var.extra_port_mappings,
  )

  # The kind cluster configuration (what you would put in a kind config
  # file). Unset values are left out so kind's defaults apply.
  kind_config = {
    kind       = "Cluster"
    apiVersion = "kind.x-k8s.io/v1alpha4"

    networking = {
      for k, v in {
        apiServerAddress  = var.api_server_address
        apiServerPort     = var.api_server_port
        podSubnet         = var.pod_subnet
        serviceSubnet     = var.service_subnet
        disableDefaultCNI = var.disable_default_cni ? true : null # true = install your own CNI afterwards
      } : k => v if v != null
    }

    nodes = concat(
      # First control-plane node: carries the port mappings and, when
      # ingress_ready is set, the ingress-ready=true label that ingress
      # controller manifests for kind select on.
      [{
        for k, v in {
          role   = "control-plane"
          labels = var.ingress_ready ? { "ingress-ready" = "true" } : null
          extraPortMappings = length(local.port_mappings) == 0 ? null : [
            for p in local.port_mappings : {
              containerPort = p.container_port
              hostPort      = p.host_port
              protocol      = p.protocol
            }
          ]
        } : k => v if v != null
      }],
      # Additional control-plane nodes (kind adds a load balancer container).
      [for i in range(var.control_plane_nodes - 1) : { role = "control-plane" }],
      # Worker nodes.
      [for i in range(var.worker_nodes) : { role = "worker" }],
    )
  }

  kind_config_yaml = yamlencode(local.kind_config)
  kubeconfig_path  = var.kubeconfig_path == null ? "" : pathexpand(var.kubeconfig_path)
}

resource "terraform_data" "cluster" {
  # Values the destroy step needs. A destroy provisioner may only read from
  # the resource itself, so they are stored here.
  input = {
    name       = var.name
    kubeconfig = local.kubeconfig_path
  }

  # Recreate the cluster when its definition changes.
  triggers_replace = [var.name, var.node_image, local.kind_config_yaml, local.kubeconfig_path]

  # Create: kind reads the configuration from standard input.
  provisioner "local-exec" {
    environment = {
      KIND_EXPERIMENTAL_PROVIDER = "podman"
      CLUSTER_NAME               = var.name
      KIND_CONFIG                = local.kind_config_yaml
      NODE_IMAGE                 = var.node_image == null ? "" : var.node_image
      KUBECONFIG_OUT             = local.kubeconfig_path
      WAIT_TIMEOUT               = var.wait_timeout
    }
    command = <<-EOT
      set -eu
      command -v kind >/dev/null 2>&1 || { echo "kind is not installed: https://kind.sigs.k8s.io/docs/user/quick-start/#installation" >&2; exit 127; }
      podman info >/dev/null 2>&1 || { echo "Podman is not installed or not running: https://podman.io/docs/installation (macOS/Windows: podman machine start)" >&2; exit 1; }
      set -- --name "$CLUSTER_NAME" --config - --wait "$WAIT_TIMEOUT"
      [ -z "$NODE_IMAGE" ] || set -- "$@" --image "$NODE_IMAGE"
      [ -z "$KUBECONFIG_OUT" ] || set -- "$@" --kubeconfig "$KUBECONFIG_OUT"
      printf '%s' "$KIND_CONFIG" | kind create cluster "$@"
    EOT
  }

  # Destroy: delete the cluster and remove it from the kubeconfig.
  provisioner "local-exec" {
    when = destroy
    environment = {
      KIND_EXPERIMENTAL_PROVIDER = "podman"
      CLUSTER_NAME               = self.input.name
      KUBECONFIG_OUT             = self.input.kubeconfig
    }
    command = <<-EOT
      set -eu
      set -- --name "$CLUSTER_NAME"
      [ -z "$KUBECONFIG_OUT" ] || set -- "$@" --kubeconfig "$KUBECONFIG_OUT"
      kind delete cluster "$@"
    EOT
  }
}
