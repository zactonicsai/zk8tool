# Generated by kubegen from podman/kind-podman.yaml for the kind cluster "dev-podman".
#
# Input variables. The defaults come from the cluster definition; override
# them in terraform.tfvars (see terraform.tfvars.example) rather than here,
# because this file is overwritten when kubegen runs again.

variable "name" {
  description = "Cluster name."
  type        = string
  default     = "dev-podman"
}

variable "node_image" {
  description = "Node image, which sets the Kubernetes version. null = the provider's default."
  type        = string
  default     = "kindest/node:v1.33.1"
}

variable "control_plane_nodes" {
  description = "Number of control-plane nodes (1, or 3 for an HA test setup)."
  type        = number
  default     = 1
}

variable "worker_nodes" {
  description = "Number of worker nodes. 0 = workloads run on the control plane."
  type        = number
  default     = 2
}

variable "ingress_ready" {
  description = "Label the first control-plane node ingress-ready=true and publish host ports 80 and 443."
  type        = bool
  default     = false
}

variable "extra_port_mappings" {
  description = "Extra host ports published on the first control-plane node."
  type        = list(object({
    container_port = number
    host_port      = number
    protocol       = optional(string, "TCP")
  }))
  default     = [
    {
      container_port = 30080
      host_port      = 8080
    },
    {
      container_port = 30443
      host_port      = 8443
    },
  ]
}

variable "api_server_address" {
  description = "Host address the API server listens on. null = 127.0.0.1."
  type        = string
  default     = null
}

variable "api_server_port" {
  description = "Host port of the API server. null = a random free port."
  type        = number
  default     = null
}

variable "pod_subnet" {
  description = "Pod network CIDR. null = kind default."
  type        = string
  default     = null
}

variable "service_subnet" {
  description = "Service network CIDR. null = kind default."
  type        = string
  default     = null
}

variable "disable_default_cni" {
  description = "Skip kindnet so another CNI (Cilium, Calico, ...) can be installed."
  type        = bool
  default     = false
}

variable "kubeconfig_path" {
  description = "File to write the kubeconfig to. null = merge into ~/.kube/config."
  type        = string
  default     = null
}

variable "wait_timeout" {
  description = "How long kind waits for the control plane to be ready, e.g. 120s or 5m."
  type        = string
  default     = "120s"
}
